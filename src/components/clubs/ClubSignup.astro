---
/**
 * Club sign-up (#join on /clubs). Posts to /api/lead with type "club" → Google Sheet tab "Club signups".
 * We ask only for: chosen clubs, parent name, phone, child's age, our school / other school (no child name).
 * The club checkboxes are the single source of truth: any `[data-pick="<slug>"]` button on the page
 * (cards, weekly schedule) toggles the matching checkbox, and `/clubs?club=<slug>#join` pre-selects one.
 */
import type { CollectionEntry } from 'astro:content';
import { getSettings } from '@/lib/content';
import { clubSlug, fill, type Club } from '@/lib/clubs';
import { t } from '@/i18n/ui';
import SectionHeading from '@/components/ui/SectionHeading.astro';
import Button from '@/components/ui/Button.astro';
interface Props { page: CollectionEntry<'clubsPage'>['data']; clubs: Club[] }
const { page: p, clubs } = Astro.props;
const j = p.join;
const f = t().form;
const s = await getSettings();
const ages = Array.from({ length: p.facts.ageMax - p.facts.ageMin + 1 }, (_, i) => p.facts.ageMin + i);
---
<section id="join" class="bg-navy qmark-band csign">
  <span class="qmark csign__q" aria-hidden="true">?</span>
  <div class="wrap sec row" style="--row-gap: 48px; align-items: flex-start">
    <div class="stack" style="flex: 1 1 380px; --stack-gap: 16px">
      <SectionHeading title={j.title} accent={j.accent} />
      <p>{j.text}</p>
      <div class="csign__total" aria-live="polite" data-total-box data-price={p.facts.price} data-currency={p.facts.currency} data-per={p.facts.perMonth}>
        <span data-chosen-line data-tpl={j.chosen}>{fill(j.chosen, { n: 0 })}</span>
        <b data-total>0 {p.facts.currency}</b>
        <span class="csign__note" data-total-note data-hint={j.chooseHint}>{j.chooseHint}</span>
      </div>
      <a class="csign__phone" href={p.facts.phoneHref}>
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2" /></svg>
        {p.facts.phone}
      </a>
    </div>

    <div class="csign__card" style="flex: 1.4 1 520px">
      <form class="stack" style="--stack-gap: 20px" data-club-form novalidate>
        <input type="hidden" name="source" value="clubs" />
        <div class="csign__hp" aria-hidden="true"><label>Website <input type="text" name="website" tabindex="-1" autocomplete="off" /></label></div>
        <fieldset class="stack" style="--stack-gap: 10px">
          <legend class="csign__label">{j.whichClubs}</legend>
          <div class="row" style="--row-gap: 8px">
            {clubs.map((c) => (
              <label class="cbox"><input type="checkbox" name="clubs" value={clubSlug(c)} data-name={c.data.name} /><span>{c.data.name}</span></label>
            ))}
          </div>
        </fieldset>
        <div class="grid-auto" style="--min: 200px; --grid-gap: 16px">
          <div class="field"><label for="cs-name">{f.parentName}</label><input id="cs-name" name="name" type="text" autocomplete="name" required maxlength="80" /></div>
          <div class="field"><label for="cs-phone">{f.phone}</label><input id="cs-phone" name="phone" type="tel" autocomplete="tel" inputmode="tel" required maxlength="30" placeholder="5XX XX XX XX" /></div>
          <div class="field"><label for="cs-age">{f.childAge}</label>
            <select id="cs-age" name="childAge"><option value="">{j.agePlaceholder}</option>{ages.map((a) => <option value={a}>{a} {j.ageSuffix}</option>)}</select>
          </div>
          <div class="field"><label for="cs-school">{j.school}</label>
            <select id="cs-school" name="school"><option value="ours">{j.schoolOurs}</option><option value="other">{j.schoolOther}</option></select>
          </div>
        </div>
        <label class="csign__consent"><input type="checkbox" name="consent" required /> <span>{f.consent}</span></label>
        <div class="row" style="--row-gap: 12px; align-items: center">
          <Button type="submit" data-label={f.submit} data-sending={f.sending}>{f.submit}</Button>
          <span class="xs muted">{j.note}</span>
        </div>
        <p class="csign__status" role="status" aria-live="polite"></p>
        <template data-msg="error">{f.error} <a href={s.phoneHref}>{s.phone}</a></template>
        <template data-msg="required">{j.required}</template>
      </form>
      <div class="csign__done pop" hidden data-done tabindex="-1">
        <span class="csign__tick" aria-hidden="true"><svg width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12l5 5 9-10" /></svg></span>
        <b class="display h3">{j.success}</b>
        <p data-done-line data-tpl={j.successChoice} data-none={j.successNone}></p>
        <button type="button" class="csign__again" data-again>{j.again}</button>
      </div>
    </div>
  </div>
</section>

<script>
  for (const form of document.querySelectorAll<HTMLFormElement>('[data-club-form]')) {
    const section = form.closest('section')!;
    const boxes = [...form.querySelectorAll<HTMLInputElement>('input[name="clubs"]')];
    const totalBox = section.querySelector<HTMLElement>('[data-total-box]')!;
    const price = Number(totalBox.dataset.price);
    const status = form.querySelector<HTMLElement>('.csign__status')!;
    const btn = form.querySelector<HTMLButtonElement>('button[type="submit"]')!;
    const done = section.querySelector<HTMLElement>('[data-done]')!;
    const msg = (k: string) => form.querySelector<HTMLTemplateElement>(`template[data-msg="${k}"]`)!.innerHTML;
    const chosen = () => boxes.filter((b) => b.checked);
    const started = Date.now();

    const sync = () => {
      const on = chosen();
      const n = on.length;
      const names = on.map((b) => b.dataset.name!);
      section.querySelector<HTMLElement>('[data-chosen-line]')!.textContent = section.querySelector<HTMLElement>('[data-chosen-line]')!.dataset.tpl!.replace('{n}', String(n));
      section.querySelector<HTMLElement>('[data-total]')!.textContent = n ? `${n * price} ${totalBox.dataset.currency} ${totalBox.dataset.per}` : `0 ${totalBox.dataset.currency}`;
      const note = section.querySelector<HTMLElement>('[data-total-note]')!;
      note.textContent = n ? `${n} × ${price} ${totalBox.dataset.currency} · ${names.join(', ')}` : note.dataset.hint!;
      // Mirror the choice on every pick button / card on the page.
      for (const b of document.querySelectorAll<HTMLElement>('[data-pick]')) {
        const isOn = on.some((x) => x.value === b.dataset.pick);
        b.setAttribute('aria-pressed', String(isOn));
        if (b.dataset.add) b.textContent = isOn ? b.dataset.added! : b.dataset.add;
        b.closest('.ccard')?.classList.toggle('is-chosen', isOn);
      }
    };
    boxes.forEach((b) => b.addEventListener('change', sync));
    document.addEventListener('click', (e) => {
      const b = (e.target as HTMLElement).closest<HTMLElement>('[data-pick]');
      if (!b) return;
      const box = boxes.find((x) => x.value === b.dataset.pick);
      if (box) { box.checked = !box.checked; sync(); }
    });
    const pre = new URLSearchParams(location.search).get('club');
    const preBox = boxes.find((x) => x.value === pre);
    if (preBox) preBox.checked = true;
    sync();

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const fd = new FormData(form);
      const data = Object.fromEntries(fd) as Record<string, string>;
      if (!data.name?.trim() || !data.phone?.trim() || !data.consent) { status.innerHTML = msg('required'); return; }
      const clubs = chosen().map((b) => b.dataset.name!);
      btn.disabled = true; btn.textContent = btn.dataset.sending!;
      try {
        const res = await fetch('/api/lead', {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({ ...data, type: 'club', clubs, elapsedMs: Date.now() - started, page: location.pathname }),
        });
        if (!res.ok) throw new Error(String(res.status));
        const line = done.querySelector<HTMLElement>('[data-done-line]')!;
        line.textContent = clubs.length ? line.dataset.tpl!.replace('{clubs}', clubs.join(', ')) : line.dataset.none!;
        form.hidden = true; done.hidden = false; done.focus();
        status.textContent = '';
      } catch {
        status.innerHTML = msg('error');
      } finally {
        btn.disabled = false; btn.textContent = btn.dataset.label!;
      }
    });
    section.querySelector('[data-again]')!.addEventListener('click', () => {
      form.reset(); sync(); done.hidden = true; form.hidden = false;
      form.querySelector<HTMLInputElement>('input[name="clubs"]')?.focus();
    });
  }
</script>

<style>
  .csign :global(.h2) { font-size: clamp(32px, 3.6vw, 50px); margin-top: 0; }
  .csign__q { color: rgba(122, 253, 255, .08); }
  .csign__total { background: rgba(255, 255, 255, .08); border-radius: 22px; padding: 22px; display: flex; flex-direction: column; gap: 6px; font-size: var(--text-sm); }
  .csign__total b { color: var(--color-hl); font-size: 40px; line-height: 1.1; font-weight: var(--weight-display); }
  .csign__note { font-size: 14px; }
  .csign__phone { color: var(--color-white); font-weight: var(--weight-display); font-size: 22px; text-decoration: none; display: inline-flex; align-items: center; gap: 10px; min-height: var(--tap); align-self: flex-start; }
  .csign__phone svg { color: var(--color-hl); }
  .csign__card { background: var(--color-white); color: var(--color-ink); border-radius: var(--radius-big); padding: 32px; min-width: 0; }
  .csign__card :focus-visible { outline-color: var(--color-navy); }
  fieldset { border: 0; margin: 0; padding: 0; min-width: 0; }
  .csign__label, .field label { font-weight: 800; font-size: var(--text-sm); color: var(--color-navy); padding: 0; }
  .cbox { position: relative; display: inline-flex; }
  .cbox input { position: absolute; opacity: 0; inset: 0; margin: 0; cursor: pointer; }
  .cbox span { min-height: var(--tap); display: inline-flex; align-items: center; padding: 0 16px; border-radius: var(--radius-pill); border: 2px solid var(--color-navy); background: var(--color-white); color: var(--color-navy); font-weight: 800; font-size: 14px; }
  .cbox input:checked + span { background: var(--color-hl); }
  .cbox input:checked + span::before { content: "✓"; margin-right: 6px; }
  .cbox input:focus-visible + span { outline: 3px solid var(--color-navy); outline-offset: 2px; }
  .field { display: flex; flex-direction: column; gap: 6px; }
  .field input, .field select { min-height: 52px; border-radius: var(--radius-control); border: 2px solid var(--color-line); padding: 0 16px; font: inherit; font-size: 16px; color: var(--color-navy); background: var(--color-white); width: 100%; box-sizing: border-box; }
  .field input:focus, .field select:focus { outline: 3px solid var(--color-hl); border-color: var(--color-navy); }
  .csign__consent { display: flex; gap: 10px; align-items: flex-start; font-size: 14px; }
  .csign__consent input { width: 20px; height: 20px; margin-top: 2px; flex: none; }
  .csign__status { margin: 0; font-weight: 700; color: var(--color-navy); }
  .csign__status:empty { display: none; }
  .csign__hp { position: absolute; left: -9999px; width: 1px; height: 1px; overflow: hidden; }
  .csign__done { display: flex; flex-direction: column; gap: 12px; align-items: flex-start; padding: 20px 0; }
  .csign__done[hidden] { display: none; }
  .csign__done:focus { outline: none; }
  .csign__done p { margin: 0; }
  .csign__tick { width: 64px; height: 64px; border-radius: 50%; background: var(--color-hl); color: var(--color-navy); display: flex; align-items: center; justify-content: center; }
  .csign__again { background: none; border: 0; font: inherit; font-weight: 800; color: var(--color-blue-dark); cursor: pointer; min-height: var(--tap); text-decoration: underline; padding: 0; }
  @media (max-width: 860px) { .csign__card { padding: 22px; } .csign__total b { font-size: 32px; } }
</style>
