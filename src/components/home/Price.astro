---
import { getPage } from '@/lib/content';
import SectionHeading from '@/components/ui/SectionHeading.astro';
const { price: p } = await getPage('homePage');
---
<section id="price" class="wrap sec stack" style="--stack-gap: 24px">
  <SectionHeading num="09" label={p.label} title={p.title} accent={p.accent} />
  <div class="row" data-placeholder={p.placeholder || undefined}>
    <div class="price">
      <div class="display price__amount">{p.amount}</div>
      <span class="strong-navy" style="font-weight: 700">{p.period}</span>
      <ul class="price__inc">{p.includes.map((x) => <li>✓ {x}</li>)}</ul>
    </div>
    <div class="card card--float stack" style="flex: 1 1 400px; --stack-gap: 16px">
      <b class="strong-navy">{p.comparison.title}</b>
      {p.comparison.rows.map((r) => (
        <div>
          <div class="bar-row">{r.ours ? <b class="strong-navy">{r.label}</b> : <span>{r.label}</span>}<b class={r.ours ? 'strong-navy' : ''}>{r.value}</b></div>
          <div class="bar"><span style={`width: ${r.percent}%; ${r.ours ? '' : 'background: var(--color-line-dashed)'}`}></span></div>
        </div>
      ))}
      <span class="xs muted">{p.comparison.note}</span>
      {p.extras.map((x, i) => <div class:list={['bar-row extra', { 'extra--first': i === 0 }]}><span>{x.label}</span><b>{x.value}</b></div>)}
    </div>
  </div>
</section>
<style>
  .price { flex: 1 1 360px; background: var(--color-hl); border-radius: var(--radius-big); padding: 40px; }
  .price__amount { font-size: clamp(64px, 10vw, 140px); line-height: 1; }
  .price__inc { list-style: none; margin: 22px 0 0; padding: 0; display: flex; flex-direction: column; gap: 6px; font-size: 16px; color: var(--color-navy); }
  .extra { font-size: 16px; }
  .extra--first { border-top: 1px solid var(--color-line); padding-top: 12px; }
  @media (max-width: 860px) { .price { padding: 28px; } }
</style>
