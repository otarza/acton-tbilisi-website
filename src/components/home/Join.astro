---
import { getPage } from '@/lib/content';
import SectionLabel from '@/components/ui/SectionLabel.astro';
import LeadForm from '@/components/shared/LeadForm.astro';
const { join } = await getPage('homePage');
---
<section id="join" class="join-wrap">
  <div class="join">
    <div class="stack" style="flex: 1 1 460px; --stack-gap: 26px">
      <SectionLabel num="10" text={join.label} onDark />
      <h2 class="display join__h">{join.title} <span class="join__accent">{join.accent}</span></h2>
      <ol class="join__steps">
        {join.steps.map((s, i) => <li><b>{String(i + 1).padStart(2, '0')} · {s.title}</b> {s.text}</li>)}
      </ol>
    </div>
    <div style="flex: 1 1 360px; min-width: 0"><LeadForm title={join.formTitle} note={join.formNote} source="home-join" /></div>
  </div>
</section>
<style>
  .join-wrap { padding: 0 var(--gutter) var(--section-y); }
  .join { max-width: var(--wrap); margin: 0 auto; background: var(--color-navy); border-radius: 24px; padding: 64px 48px; display: flex; flex-wrap: wrap; gap: 40px; }
  .join__h { margin: 0; font-size: clamp(30px, 4.5vw, 57px); line-height: 1.05; color: var(--color-white); }
  .join__accent { color: var(--color-blue-soft); }
  .join__steps { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 12px; color: var(--color-on-dark); }
  .join__steps b { color: var(--color-blue-soft); }
  @media (max-width: 860px) { .join { padding: 32px 20px; border-radius: 16px; } }
</style>
