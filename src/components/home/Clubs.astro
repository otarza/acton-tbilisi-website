---
/**
 * Homepage: after-school clubs (right after the "day" section). Copy: home.yaml → clubs.
 * Tiles come from src/content/clubs/ka/; interest chips (JS) highlight matching tiles.
 */
import { getPage } from '@/lib/content';
import { getClubs, clubUrl, clubVars } from '@/lib/clubs';
import { CLUB_CATEGORIES } from '@/content.config';
import { t } from '@/i18n/ui';
import SectionHeading from '@/components/ui/SectionHeading.astro';
import Photo from '@/components/ui/Photo.astro';
import Button from '@/components/ui/Button.astro';
import ClubIcon from '@/components/clubs/ClubIcon.astro';
import Fact from '@/components/clubs/Fact.astro';

const { clubs: c } = await getPage('homePage');
const page = await getPage('clubsPage');
const clubs = await getClubs();
const ui = t().clubs;
const cats = CLUB_CATEGORIES.filter((k) => clubs.some((x) => x.data.category === k));
---
<section id="clubs" class="bg-cyan qmark-band hclubs" data-home-clubs>
  <span class="qmark" aria-hidden="true">?</span>
  <div class="wrap sec stack" style="--stack-gap: 40px">
    <div class="row" style="--row-gap: 48px; align-items: center">
      <div class="stack" style="flex: 1 1 480px; --stack-gap: 20px">
        <SectionHeading num={page.facts.time.split('–')[0]} label={c.kicker} title={c.title} accent={c.accent} after={c.titleAfter} placeholder={c.placeholder} />
        <p class="lead">{c.lead}</p>
        <div class="grid-auto" style="--min: 150px; --grid-gap: 12px">
          {c.facts.map((f) => <Fact big={f.big} text={f.text} />)}
        </div>
      </div>
      <div class="hclubs__photos" style="flex: 1 1 440px">
        {c.photos.map((id, i) => <div class:list={['hclubs__photo', { 'hclubs__photo--tall': i === 0 }]}><Photo id={id} widths={[400, 800]} sizes="(max-width: 860px) 50vw, 300px" /></div>)}
      </div>
    </div>

    <div class="row hclubs__chips" style="--row-gap: 10px; align-items: center" role="group" aria-label={ui.interest} data-js-only hidden>
      <b class="hclubs__chiplabel">{c.interestLabel}</b>
      <button type="button" class="fchip" aria-pressed="true" data-cat="">{c.allLabel}</button>
      {cats.map((k) => <button type="button" class="fchip" aria-pressed="false" data-cat={k}>{page.categories[k]}</button>)}
    </div>

    <ul class="hclubs__grid" role="list">
      {clubs.map((club) => (
        <li><a href={clubUrl(club)} class="hclubs__tile" style={clubVars(club)} data-cat={club.data.category}>
          <span class="hclubs__ico"><ClubIcon d={club.data.icon} /></span>
          <span class="display hclubs__name">{club.data.name}</span>
          <span class="hclubs__tag">{club.data.tagline}</span>
        </a></li>
      ))}
    </ul>

    <div class="hclubs__cta">
      <div class="stack" style="--stack-gap: 4px; flex: 1 1 420px">
        <b class="hclubs__ctatitle">{c.ctaTitle}</b>
        <span>{c.ctaText}</span>
      </div>
      <div class="row" style="--row-gap: 12px">
        <Button href={page.facts.phoneHref} variant="hl">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2" /></svg>
          {page.facts.phone}
        </Button>
        <Button href="/clubs" variant="light">{c.ctaAll}</Button>
      </div>
    </div>
  </div>
</section>
<script>
  for (const root of document.querySelectorAll<HTMLElement>('[data-home-clubs]')) {
    const chips = [...root.querySelectorAll<HTMLButtonElement>('[data-cat]:is(button)')];
    const tiles = [...root.querySelectorAll<HTMLElement>('.hclubs__tile')];
    root.querySelector<HTMLElement>('[data-js-only]')!.hidden = false;
    const pick = (cat: string) => {
      for (const b of chips) b.setAttribute('aria-pressed', String(b.dataset.cat === cat));
      for (const tile of tiles) {
        tile.classList.toggle('is-dim', !!cat && tile.dataset.cat !== cat);
        tile.classList.toggle('is-match', !!cat && tile.dataset.cat === cat);
      }
    };
    for (const b of chips) b.addEventListener('click', () => pick(b.getAttribute('aria-pressed') === 'true' ? '' : b.dataset.cat!));
  }
</script>
<style>
  .hclubs__photos { display: grid; grid-template-columns: 1.15fr 1fr; grid-template-rows: 200px 200px; gap: 14px; }
  .hclubs__photo { border-radius: 22px; overflow: hidden; border: 4px solid var(--color-white); box-shadow: 0 14px 34px rgba(11, 31, 74, .18); }
  .hclubs__photo--tall { grid-row: span 2; }
  .hclubs__chiplabel { color: var(--color-navy); font-size: var(--text-sm); margin-right: 4px; }
  .hclubs__grid { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(208px, 1fr)); gap: 16px; }
  .hclubs__tile { height: 100%; box-sizing: border-box; display: flex; flex-direction: column; gap: 12px; background: var(--color-white); border-radius: 22px; padding: 20px; text-decoration: none; color: var(--color-ink); border: 3px solid transparent; min-height: 178px; transition: transform .15s, box-shadow .15s, opacity .2s; }
  .bg-cyan .hclubs__tile { color: var(--color-ink); }
  .hclubs__tile:hover { transform: translateY(-3px); box-shadow: 0 18px 40px rgba(11, 31, 74, .16); border-color: var(--color-navy); }
  .hclubs__tile:focus-visible { outline: 3px solid var(--color-navy); outline-offset: 3px; }
  .hclubs__tile.is-dim { opacity: .38; }
  .hclubs__tile.is-match { border-color: var(--color-navy); }
  .hclubs__ico { width: 52px; height: 52px; border-radius: 16px; display: flex; align-items: center; justify-content: center; flex: none; background: var(--club-bg); color: var(--club-fg); }
  .hclubs__name { font-size: 20px; line-height: 1.2; }
  .hclubs__tag { font-size: 15px; line-height: 1.45; }
  .hclubs__cta { background: var(--color-navy); color: var(--color-on-dark); border-radius: var(--radius-big); padding: 28px 32px; display: flex; flex-wrap: wrap; gap: 20px; align-items: center; justify-content: space-between; }
  .hclubs__ctatitle { color: var(--color-white); font-size: 22px; line-height: 1.3; }
  .hclubs__cta :focus-visible { outline-color: var(--color-hl); }
  @media (max-width: 860px) {
    .hclubs__photos { grid-template-rows: 150px 150px; gap: 10px; }
    .hclubs__grid { grid-template-columns: 1fr 1fr; gap: 10px; }
    .hclubs__tile { padding: 14px; min-height: 0; gap: 8px; }
    .hclubs__ico { width: 44px; height: 44px; border-radius: 14px; }
    .hclubs__name { font-size: 17px; }
    .hclubs__tag { font-size: 14px; }
    .hclubs__cta { padding: 22px; }
    .hclubs__cta .btn { width: 100%; }
  }
  @media (prefers-reduced-motion: reduce) { .hclubs__tile { transition: none; } .hclubs__tile:hover { transform: none; } }
</style>
