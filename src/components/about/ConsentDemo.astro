---
/** Interactive sample of the photo-consent form. Nothing is saved: it only shows parents what they will choose. */
import { getPage } from '@/lib/content';
const { privacy } = await getPage('aboutPage');
const c = privacy.consentDemo;
---
<div class="card card--float stack" style="--stack-gap: 12px" data-consent data-none={c.noneText} data-some={c.someText}>
  <b class="strong-navy">{c.title}</b>
  <span class="small muted">{c.intro}</span>
  {c.switches.map((s) => (
    <button type="button" role="switch" aria-checked={s.on ? 'true' : 'false'} class="sw">
      <span><b>{s.label}</b><br /><span class="small muted">{s.hint}</span></span>
      <span class="sw__track" aria-hidden="true"><span class="sw__knob"></span></span>
    </button>
  ))}
  <div class="sw__sum" aria-live="polite" data-summary></div>
</div>
<script>
  for (const root of document.querySelectorAll<HTMLElement>('[data-consent]')) {
    const sws = root.querySelectorAll<HTMLButtonElement>('[role="switch"]');
    const sum = root.querySelector<HTMLElement>('[data-summary]')!;
    const update = () => {
      const n = [...sws].filter((s) => s.getAttribute('aria-checked') === 'true').length;
      sum.textContent = n === 0 ? root.dataset.none! : root.dataset.some!.replace('{n}', String(n)).replace('{total}', String(sws.length));
    };
    sws.forEach((s) => s.addEventListener('click', () => { s.setAttribute('aria-checked', String(s.getAttribute('aria-checked') !== 'true')); update(); }));
    update();
  }
</script>
<style>
  .sw { display: flex; justify-content: space-between; align-items: center; gap: 16px; text-align: left; background: var(--color-white); border: 1px solid var(--color-line); border-radius: var(--radius-card); padding: 14px 16px; cursor: pointer; color: var(--color-navy); }
  .sw__track { position: relative; width: 50px; height: 28px; border-radius: 999px; background: #B9C6D8; flex: none; transition: background .2s; }
  .sw__knob { position: absolute; top: 3px; left: 3px; width: 22px; height: 22px; border-radius: 50%; background: var(--color-white); transition: left .2s; }
  .sw[aria-checked="true"] .sw__track { background: var(--color-green); }
  .sw[aria-checked="true"] .sw__knob { left: 25px; }
  .sw__sum { background: var(--color-bg-ice); border-radius: var(--radius-card); padding: 14px 16px; color: var(--color-navy); font-weight: 700; }
</style>
