---
/** Round author avatar: the team member's photo if `photo` is set in their team file, otherwise their initial. */
import Photo from '@/components/ui/Photo.astro';
interface Props { name: string; color: string; photo?: string; size?: number; ring?: boolean }
const { name, color, photo, size = 44, ring = false } = Astro.props;
---
<span class:list={['aav', { 'aav--ring': ring }]} style={`--s: ${size}px; background: ${color}`} aria-hidden="true">
  {photo ? <Photo id={photo} alt="" widths={[size * 2]} sizes={`${size}px`} /> : name.charAt(0)}
</span>
<style>
  .aav { width: var(--s); height: var(--s); font-size: calc(var(--s) * .4); border-radius: 50%; color: var(--color-navy); font-weight: 900; display: inline-flex; align-items: center; justify-content: center; flex: none; overflow: hidden; line-height: 1; }
  .aav :global(img) { width: 100%; height: 100%; object-fit: cover; }
  .aav--ring { border: 6px solid var(--color-white); box-shadow: 0 24px 50px rgba(11, 31, 74, .18); }
</style>
