---
/** Number of days until `date`. Rendered at build time and refreshed in the browser. */
interface Props { date: Date; suffix?: 'in' | 'plain' }
const { date, suffix = 'in' } = Astro.props;
const days = Math.max(0, Math.ceil((date.getTime() - Date.now()) / 86400000));
const fmt = (n: number) => (suffix === 'in' ? `${n} დღეში` : `${n} დღე`);
---
<span data-countdown={date.toISOString()} data-suffix={suffix}>{fmt(days)}</span>
<script>
  for (const el of document.querySelectorAll<HTMLElement>('[data-countdown]')) {
    const n = Math.max(0, Math.ceil((new Date(el.dataset.countdown!).getTime() - Date.now()) / 86400000));
    el.textContent = el.dataset.suffix === 'in' ? `${n} დღეში` : `${n} დღე`;
  }
</script>
