---
/**
 * The on-site assistant. It is deliberately NOT a free-form chatbot: it only returns answers that
 * already exist in src/content/faq/<lang>/ (approved by the school), shows the source, and hands
 * sensitive topics (`handoff: true`) or unknown questions to a human. Matching runs in the browser.
 * See docs/ASSISTANT.md for how to upgrade it to an LLM later without breaking these rules.
 */
import { getLocalized, getSettings, slugOf } from '@/lib/content';
import { t } from '@/i18n/ui';
const ui = t().assistant;
const s = await getSettings();
const faqs = await getLocalized('faq');
const plain = (md = '') => md.replace(/<!--[\s\S]*?-->/g, '').split(/\n\s*\n/).map((p) => p.trim()).filter(Boolean)[0]?.replace(/[*_`#>\[\]]/g, '') ?? '';
const kb = faqs.map((f) => ({
  q: f.data.question,
  a: f.data.assistantAnswer ?? plain(f.body),
  k: f.data.keywords,
  h: f.data.handoff,
  href: `/faq#${slugOf(f.id)}`,
}));
const chips = faqs.filter((f) => f.data.chip).sort((a, b) => a.data.order - b.data.order).map((f) => ({ label: f.data.chip!, i: faqs.indexOf(f) }));
---
<div class="card card--float asst stack" style="--stack-gap: 12px" data-assistant={JSON.stringify(kb)} data-human={s.messengerUrl}>
  <div class="row" style="justify-content: space-between; align-items: center; --row-gap: 8px">
    <b class="strong-navy">{ui.title}</b><span class="tag tag--blue">{ui.badge}</span>
  </div>
  <div class="asst__log" aria-live="polite" data-log>
    <div class="msg msg--bot">{ui.intro}</div>
  </div>
  <form class="asst__form" data-ask>
    <label class="sr-only" for="asst-input">{ui.placeholder}</label>
    <input id="asst-input" type="text" maxlength="200" placeholder={ui.placeholder} autocomplete="off" />
    <button type="submit" class="btn btn--primary btn--sm">{ui.ask}</button>
  </form>
  <div class="row" style="--row-gap: 8px">
    {chips.map((c) => <button type="button" class="asst__chip" data-chip={c.i}>{c.label}</button>)}
    <a href={s.messengerUrl} class="asst__human" rel="noopener">{ui.human}</a>
  </div>
  <template data-t-source>{ui.source}</template>
  <template data-t-handoff>{ui.handoff}</template>
  <template data-t-notfound>{ui.notFound}</template>
  <template data-t-human>{ui.human}</template>
</div>
<script>
  type Item = { q: string; a: string; k: string[]; h: boolean; href: string };
  const norm = (s: string) => s.toLowerCase().replace(/[^\p{L}\p{N}\s]/gu, ' ').split(/\s+/).filter((w) => w.length > 1);
  // Georgian words change endings a lot (ფასი / ფასს / ფასის), so compare word stems (first 4 letters).
  const stem = (w: string) => w.slice(0, Math.max(3, Math.min(5, w.length - 1)));

  function best(items: Item[], query: string): Item | null {
    const qs = norm(query).map(stem);
    if (!qs.length) return null;
    let top: Item | null = null, topScore = 0;
    for (const it of items) {
      const kw = it.k.flatMap(norm).map(stem);
      const words = norm(it.q).map(stem);
      let score = 0;
      for (const w of qs) {
        if (kw.some((k) => k.startsWith(w) || w.startsWith(k))) score += 3;
        if (words.some((k) => k.startsWith(w) || w.startsWith(k))) score += 1;
      }
      if (score > topScore) { topScore = score; top = it; }
    }
    return topScore >= 3 ? top : null;
  }

  for (const root of document.querySelectorAll<HTMLElement>('[data-assistant]')) {
    const kb: Item[] = JSON.parse(root.dataset.assistant!);
    const log = root.querySelector<HTMLElement>('[data-log]')!;
    const tx = (k: string) => root.querySelector<HTMLTemplateElement>(`template[data-t-${k}]`)!.content.textContent!;
    const add = (cls: string, build: (el: HTMLDivElement) => void) => {
      const el = document.createElement('div'); el.className = `msg ${cls} pop`; build(el); log.append(el); el.scrollIntoView({ block: 'nearest' });
    };
    const answer = (question: string, it: Item | null) => {
      add('msg--me', (el) => (el.textContent = question));
      add('msg--bot', (el) => {
        if (!it) {
          el.textContent = tx('notfound') + ' ';
        } else {
          el.textContent = it.a;
          if (it.h) el.append(document.createElement('br'), tx('handoff'));
          const src = document.createElement('div'); src.className = 'msg__src';
          const a = document.createElement('a'); a.href = it.href; a.textContent = `„${it.q}“`;
          src.append(`${tx('source')} `, a); el.append(src);
        }
        if (!it || it.h) {
          const h = document.createElement('a'); h.href = root.dataset.human!; h.textContent = `${tx('human')} →`; h.className = 'msg__human';
          el.append(h);
        }
      });
    };
    root.querySelectorAll<HTMLButtonElement>('[data-chip]').forEach((b) => b.addEventListener('click', () => answer(b.textContent!, kb[Number(b.dataset.chip)])));
    root.querySelector<HTMLFormElement>('[data-ask]')!.addEventListener('submit', (e) => {
      e.preventDefault();
      const input = (e.currentTarget as HTMLFormElement).querySelector('input')!;
      const q = input.value.trim(); if (!q) return;
      answer(q, best(kb, q)); input.value = '';
    });
  }
</script>
<style>
  .asst__log { display: flex; flex-direction: column; gap: 10px; max-height: 360px; overflow-y: auto; }
  .asst :global(.msg) { padding: 12px 16px; font-size: 16px; max-width: 92%; }
  .asst :global(.msg--bot) { background: #F1F6FB; border-radius: 12px 18px 18px 4px; align-self: flex-start; }
  .asst :global(.msg--me) { background: var(--color-blue); color: var(--color-white); border-radius: 12px 18px 4px 18px; align-self: flex-end; max-width: 85%; }
  .asst :global(.msg__src) { margin-top: 6px; font-size: var(--text-xs); color: var(--color-muted); }
  .asst :global(.msg__human) { display: inline-block; margin-top: 6px; font-weight: 800; }
  .asst__form { display: flex; gap: 8px; }
  .asst__form input { flex: 1; min-width: 0; min-height: var(--tap); border: 1px solid var(--color-line-strong); border-radius: var(--radius-card); padding: 0 14px; font: inherit; font-size: 16px; }
  .asst__chip { min-height: 44px; border: 1px solid var(--color-line-strong); background: var(--color-white); border-radius: 999px; padding: 0 14px; font-size: var(--text-sm); color: var(--color-navy); cursor: pointer; }
  .asst__human { min-height: 44px; display: inline-flex; align-items: center; background: var(--color-navy); color: var(--color-white); border-radius: 999px; padding: 0 16px; font-size: var(--text-sm); text-decoration: none; font-weight: 700; }
  .asst__human:hover { color: var(--color-white); }
</style>
