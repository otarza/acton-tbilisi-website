---
import Button from '@/components/ui/Button.astro';
interface Props { title: string; accent: string; button: string; href?: string }
const { title, accent, button, href = '/#join' } = Astro.props;
---
<section class="bg-cyan qmark-band">
  <span class="qmark qmark--cta" aria-hidden="true">?</span>
  <div class="wrap cta">
    <p class="display cta__t">{title} <span class="hl">{accent}</span></p>
    <Button href={href} size="lg">{button}</Button>
  </div>
</section>
<style>
  .cta { padding-top: 72px; padding-bottom: 72px; display: flex; flex-wrap: wrap; gap: 24px 40px; align-items: center; justify-content: space-between; }
  .cta__t { font-size: clamp(32px, 4vw, 56px); line-height: 1.08; flex: 1 1 520px; }
  .qmark--cta { font-size: 340px; top: -90px; right: 4%; }
</style>
