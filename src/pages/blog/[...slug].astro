---
/** A single blog post. The URL is /blog/<file name without .md>. */
import { render } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Photo from '@/components/ui/Photo.astro';
import CtaBand from '@/components/shared/CtaBand.astro';
import SectionLabel from '@/components/ui/SectionLabel.astro';
import { getLocalized, slugOf } from '@/lib/content';
import { formatDateKa } from '@/lib/georgian';
import { t } from '@/i18n/ui';

export async function getStaticPaths() {
  const posts = await getLocalized('posts');
  return posts
    .filter((p) => import.meta.env.DEV || !p.data.draft)
    .map((post) => ({ params: { slug: slugOf(post.id) }, props: { post } }));
}
const { post } = Astro.props;
const { Content } = await render(post);
const ui = t().blog;
---
<BaseLayout title={`${post.data.title} · ექტონის აკადემია`} description={post.data.description} ogPhoto={post.data.cover} type="article">
  <section slot="hero" class="wrap post-hero stack" style="--stack-gap: 16px" data-placeholder={post.data.placeholder || undefined}>
    <a href="/blog" class="small strong-navy">{ui.back}</a>
    <SectionLabel text={post.data.tags[0] ?? ui.title} num="✦" />
    <h1 class="display h1 post-hero__h">{post.data.title}</h1>
    <p class="lead">{post.data.description}</p>
    <span class="small muted">{formatDateKa(post.data.date)}{post.data.author && ` · ${post.data.author}`}</span>
  </section>
  <article class="wrap sec">
    {post.data.cover && <div class="post-cover"><Photo id={post.data.cover} loading="eager" sizes="(max-width: 860px) 100vw, 960px" widths={[400, 800, 1200]} /></div>}
    <div class="prose"><Content /></div>
    {post.data.tags.length > 0 && <div class="row tags" style="--row-gap: 8px">{post.data.tags.map((tg) => <span class="tag tag--blue">{tg}</span>)}</div>}
  </article>
  <CtaBand title={ui.ctaTitle} accent={ui.ctaAccent} button={t().bookMeeting} />
</BaseLayout>
<style>
  .post-hero { padding-top: 32px; padding-bottom: 64px; }
  .post-hero__h { font-size: clamp(32px, 4.2vw, 56px); max-width: 900px; }
  .post-cover { max-width: 960px; height: clamp(240px, 40vw, 480px); border-radius: var(--radius-card); overflow: hidden; margin-bottom: 40px; }
  .tags { margin-top: 32px; }
</style>
