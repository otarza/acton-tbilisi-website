---
/** BLOG LIST. Posts: src/content/posts/ka/YYYY-MM-DD-slug.md (draft: true hides a post on the live site). */
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/shared/PageHero.astro';
import PostCard from '@/components/shared/PostCard.astro';
import { getLocalized } from '@/lib/content';
import { t } from '@/i18n/ui';
const ui = t().blog;
const posts = (await getLocalized('posts'))
  .filter((p) => import.meta.env.DEV || !p.data.draft)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
---
<BaseLayout title={`${ui.title} · ექტონის აკადემია საბურთალო`} description={ui.lead}>
  <PageHero slot="hero" label={ui.title} title={ui.title} lead={ui.lead} />
  <section class="wrap sec">
    {posts.length === 0 ? <p>{ui.empty}</p> : (
      <div class="grid-auto" style="--min: 320px; --grid-gap: 24px">
        {posts.map((p) => <PostCard post={p} />)}
      </div>
    )}
  </section>
</BaseLayout>
