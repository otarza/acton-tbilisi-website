---
/**
 * LIVING STYLE GUIDE at /design-system (not linked, not indexed).
 * Shows every token and building block so people and AI agents can see what exists before adding new styles.
 * Keep it in sync with src/styles/tokens.css and docs/DESIGN-SYSTEM.md.
 */
import BaseLayout from '@/layouts/BaseLayout.astro';
import SectionHeading from '@/components/ui/SectionHeading.astro';
import SectionLabel from '@/components/ui/SectionLabel.astro';
import Button from '@/components/ui/Button.astro';
import Caps from '@/components/ui/Caps.astro';
import Photo from '@/components/ui/Photo.astro';
import { getCollection } from 'astro:content';

const colors = [
  ['--color-navy', 'Primary. Headings, buttons, dark sections'], ['--color-navy-2', 'Raised surface on navy'],
  ['--color-blue', 'Accent words, progress'], ['--color-blue-dark', 'Links, tags'], ['--color-blue-soft', 'Accent text on navy'],
  ['--color-cyan', 'Logo + decorative lines ONLY (no white text on it)'], ['--color-ink', 'Body text'], ['--color-muted', 'Captions'],
  ['--color-bg-mist', 'Page heroes'], ['--color-bg-paper', 'Alternating sections'], ['--color-bg-blue', 'Price block'], ['--color-bg-ice', 'Callouts in cards'],
  ['--color-line', 'Borders'], ['--color-yellow', 'Exhibition highlight'], ['--color-green', 'Success, call button'], ['--color-red', 'Tag colour'],
];
const photos = await getCollection('photos');
---
<BaseLayout title="Design system · Acton Tbilisi" noindex>
  <section slot="hero" class="wrap" style="padding: 32px var(--gutter) 64px">
    <SectionHeading level={1} label="დიზაინ სისტემა" num="✦" title="Design system" accent="S5 · calm navy" />
    <p class="lead" style="margin-top: 16px">Tokens: <code>src/styles/tokens.css</code> · Docs: <code>docs/DESIGN-SYSTEM.md</code></p>
  </section>

  <section class="wrap sec stack">
    <h2 class="display h3">Colours</h2>
    <div class="grid-auto" style="--min: 220px; --grid-gap: 12px">
      {colors.map(([v, use]) => <div class="sw"><span class="sw__c" style={`background: var(${v})`}></span><code>{v}</code><span class="xs muted">{use}</span></div>)}
    </div>
  </section>

  <section class="wrap sec stack bg-paper" style="border-radius: 12px">
    <h2 class="display h3">Typography</h2>
    <p class="display h1">Display H1 · სწავლა თავგადასავალია</p>
    <p class="display h2">Display H2 · <span class="accent">accent</span></p>
    <p class="display h3">H3 · Noto Serif Georgian 700</p>
    <p class="lead">Lead · Noto Sans Georgian 19px</p>
    <p>Body · 18px / 1.6 · ბავშვი თავად მართავს თავის განათლებას.</p>
    <p class="small muted">Small muted · 15px</p>
    <div><SectionLabel num="01" text="სექციის ლეიბლი" /> &nbsp; <Caps text="მთავრული ავტომატურად" /></div>
  </section>

  <section class="wrap sec stack">
    <h2 class="display h3">Buttons, tags, choices</h2>
    <div class="row"><Button>Primary</Button><Button variant="ghost">Ghost</Button><Button variant="soft">Soft</Button><Button size="sm">Small</Button><Button size="lg">Large</Button></div>
    <div class="row" style="--row-gap: 8px"><span class="tag tag--blue">blue</span><span class="tag tag--teal">teal</span><span class="tag tag--red">red</span><span class="tag tag--gold">gold</span><span class="tag tag--green">green</span><span class="tag tag--navy">navy</span></div>
    <div class="row" style="--row-gap: 8px"><button class="choice" aria-pressed="true">Selected</button><button class="choice" aria-pressed="false">Choice</button></div>
    <div class="bg-navy" style="padding: 24px; border-radius: 12px"><Button variant="light">Light on navy</Button></div>
  </section>

  <section class="wrap sec stack">
    <h2 class="display h3">Cards & bars</h2>
    <div class="grid-auto">
      <div class="card card--paper">.card.card--paper</div>
      <div class="card card--outline">.card.card--outline</div>
      <div class="card card--float">.card.card--float</div>
      <div class="card card--dashed">.card.card--dashed</div>
    </div>
    <div class="card card--outline stack" style="--stack-gap: 10px"><div class="bar-row"><span>.bar</span><b>60%</b></div><div class="bar"><span style="width: 60%"></span></div></div>
  </section>

  <section class="wrap sec stack">
    <h2 class="display h3">Photo register ({photos.length})</h2>
    <div class="grid-auto" style="--min: 200px; --grid-gap: 12px">
      {photos.map((p) => <figure class="ph"><div class="ph__img"><Photo id={p.id} widths={[400]} sizes="200px" /></div><figcaption class="xs"><code>{p.id}</code> · <span class:list={['tag', p.data.consent === 'signed' ? 'tag--green' : p.data.consent === 'pending' ? 'tag--gold' : 'tag--blue']}>{p.data.consent}</span></figcaption></figure>)}
    </div>
  </section>
</BaseLayout>
<style>
  .sw { display: flex; flex-direction: column; gap: 4px; }
  .sw__c { height: 64px; border-radius: 8px; border: 1px solid var(--color-line); }
  .ph { margin: 0; display: flex; flex-direction: column; gap: 6px; }
  .ph__img { height: 140px; border-radius: 8px; overflow: hidden; }
</style>
