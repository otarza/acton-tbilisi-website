---
/**
 * ONE CLUB: /clubs/<file name without .md> (src/content/clubs/ka/).
 * Club switcher, hero (photo or coloured icon tile), activities, a typical session, takeaways, guide,
 * sticky facts card with the price, related clubs. Shared facts + copy: src/content/pages/ka/clubs.yaml.
 */
import { render } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import SectionHeading from '@/components/ui/SectionHeading.astro';
import Photo from '@/components/ui/Photo.astro';
import Button from '@/components/ui/Button.astro';
import ClubIcon from '@/components/clubs/ClubIcon.astro';
import { getPage } from '@/lib/content';
import { getClubs, clubSlug, clubUrl, clubVars, relatedClubs, type Club } from '@/lib/clubs';
import { t } from '@/i18n/ui';

export async function getStaticPaths() {
  const all = await getClubs();
  return all.map((club) => ({ params: { slug: clubSlug(club) }, props: { club, all } }));
}
interface Props { club: Club; all: Club[] }
const { club, all } = Astro.props;
const c = club.data;
const p = await getPage('clubsPage');
const k = p.club;
const ui = t().clubs;
const { Content } = await render(club);
const signUp = `/clubs?club=${clubSlug(club)}#join`;
const dayLine = c.days.map((i) => p.days[i].full).join(', ');
const pad = (n: number) => String(n).padStart(2, '0');
const related = relatedClubs(club, all);
---
<BaseLayout title={`${c.name} · ${p.seo.title}`} description={`${c.name}: ${c.tagline}. ${p.facts.agesText}, ${p.facts.frequency}, ${p.facts.time}, ${p.facts.price} ${p.facts.currency} ${p.facts.perMonth}.`} ogPhoto={c.photo ?? p.hero.photos[0]}>
  <Fragment slot="hero">
    <div class="wrap">
      <nav class="csw" aria-label={k.switcher}>
        {all.map((x) => (
          <a href={clubUrl(x)} class="csw__chip" style={clubVars(x)} aria-current={x.id === club.id ? 'page' : undefined}>
            <span class="csw__dot"><ClubIcon d={x.data.icon} size={16} stroke={2.4} /></span>{x.data.name}
          </a>
        ))}
      </nav>
    </div>
    <section class="wrap row chero" style={`--row-gap: 48px; ${clubVars(club)}`}>
      <div class="stack chero__text" style="--stack-gap: 18px">
        <nav aria-label={ui.breadcrumb} class="crumb"><a href="/clubs">{k.breadcrumb}</a> <span aria-hidden="true">›</span> <span aria-current="page">{c.name}</span></nav>
        <span class="chero__ico"><ClubIcon d={c.icon} size={42} /></span>
        <h1 class="display chero__h1">{c.name}</h1>
        <div class="stack" style="--stack-gap: 18px" data-placeholder={c.placeholder || undefined}>
          <p class="chero__tag"><span>{c.tagline}</span></p>
          <div class="lead chero__desc"><Content /></div>
        </div>
        <div class="row" style="--row-gap: 12px; padding-top: 6px"><Button href={signUp}>{k.signUp}</Button><Button href={p.facts.phoneHref} variant="light">{p.facts.phone}</Button></div>
      </div>
      <div class:list={['chero__cover', { 'chero__cover--icon': !c.photo }]}>
        {c.photo ? <Photo id={c.photo} loading="eager" widths={[400, 800]} sizes="(max-width: 860px) 100vw, 560px" /> : <div class="chero__soon"><ClubIcon d={c.icon} size={140} stroke={1.4} /><span>{k.photoSoon}</span></div>}
      </div>
    </section>
  </Fragment>

  <div class="wrap row cbody" style="--row-gap: 48px; align-items: flex-start">
    <div class="stack cmain" style="--stack-gap: 64px">
      {c.activities.length > 0 && (
        <section class="stack" style="--stack-gap: 20px" data-placeholder={c.placeholder || undefined}>
          <SectionHeading title={k.activities.title} accent={k.activities.accent} after={k.activities.after} />
          <ol class="cacts" role="list">
            {c.activities.map((a, i) => <li style={clubVars(club)}><span class="display cacts__n">{pad(i + 1)}</span><b>{a.title}</b><span>{a.text}</span></li>)}
          </ol>
        </section>
      )}

      <section class="stack" style="--stack-gap: 20px" data-placeholder={k.timeline.placeholder || undefined}>
        <SectionHeading title={k.timeline.title} accent={k.timeline.accent} />
        <ol class="ctime" role="list">
          {k.timeline.items.map((s) => <li><b class="ctime__t">{s.time}</b><span><b>{s.title}</b><br /><span class="small">{s.text}</span></span></li>)}
        </ol>
      </section>

      {c.gains.length > 0 && (
        <section class="stack" style="--stack-gap: 18px" data-placeholder={c.placeholder || undefined}>
          <SectionHeading title={k.gains.title} accent={k.gains.accent} after={k.gains.after} />
          <ul class="cgains" role="list">
            {c.gains.map((g) => <li><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12l5 5 9-10" /></svg>{g}</li>)}
          </ul>
        </section>
      )}

      <section class="cguide" data-placeholder={!c.guide || c.placeholder || undefined}>
        <span class="cguide__av" aria-hidden="true">{c.guide ? c.guide.name.trim()[0] : '?'}</span>
        <div class="stack" style="--stack-gap: 4px; flex: 1 1 300px">
          <b class="strong-navy small">{k.guide.label}</b>
          <b class="display h3">{c.guide?.name ?? k.guide.emptyName}</b>
          <span class="small">{c.guide?.bio ?? k.guide.emptyBio}</span>
        </div>
      </section>
    </div>

    <aside class="cside stack" style="--stack-gap: 16px">
      <div class="cfacts">
        <b class="display h3 cfacts__title">{k.factsTitle}</b>
        <dl>
          <div><dt>{k.factLabels.ages}</dt><dd>{p.facts.agesText}</dd></div>
          <div><dt>{k.factLabels.frequency}</dt><dd>{p.facts.frequency}</dd></div>
          <div><dt>{k.factLabels.time}</dt><dd>{p.facts.time}</dd></div>
          <div data-placeholder={c.placeholder || undefined}><dt>{k.factLabels.days}</dt><dd>{dayLine}</dd></div>
          <div data-placeholder={k.groupSize.placeholder || undefined}><dt>{k.factLabels.group}</dt><dd>{k.groupSize.value}</dd></div>
          <div><dt>{k.factLabels.audience}</dt><dd>{p.facts.audience}</dd></div>
        </dl>
        <div class="cfacts__price"><span>{k.factLabels.price}</span><b>{p.facts.price} {p.facts.currency} <small>{p.facts.perMonth}</small></b></div>
        <Button href={signUp}>{k.signUp}</Button>
      </div>
      <div class="cask">
        <span>{k.question}</span>
        <a href={p.facts.phoneHref}><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2" /></svg>{p.facts.phone}</a>
      </div>
    </aside>
  </div>

  <section class="bg-sky crel-sec">
    <div class="wrap sec stack" style="--stack-gap: 24px">
      <div class="row" style="justify-content: space-between; align-items: flex-end; --row-gap: 16px">
        <SectionHeading title={k.related.title} accent={k.related.accent} after={k.related.after} />
        <Button href="/clubs" variant="ghost">{k.related.all}</Button>
      </div>
      <ul class="crel" role="list">
        {related.map((x) => (
          <li><a href={clubUrl(x)} class="crel__card" style={clubVars(x)}>
            <span class="crel__ico"><ClubIcon d={x.data.icon} /></span>
            <b class="display crel__name">{x.data.name}</b>
            <span>{x.data.tagline}</span>
            <span class="crel__see">{k.related.see}</span>
          </a></li>
        ))}
      </ul>
    </div>
  </section>
</BaseLayout>

<style>
  .csw { display: flex; gap: 8px; overflow-x: auto; padding: 4px 2px 14px; scrollbar-width: thin; }
  .csw__chip { min-height: var(--tap); padding: 0 14px 0 8px; border-radius: var(--radius-pill); border: 2px solid var(--color-navy); background: var(--color-white); color: var(--color-navy); font-weight: 800; font-size: 14px; display: inline-flex; align-items: center; gap: 8px; white-space: nowrap; text-decoration: none; flex: none; box-sizing: border-box; }
  .bg-cyan .csw__chip { color: var(--color-navy); }
  .csw__chip:hover { background: var(--color-bg-sky); }
  .csw__chip[aria-current="page"], .bg-cyan .csw .csw__chip[aria-current="page"] { background: var(--color-navy); color: var(--color-white); }
  .csw__dot { width: 28px; height: 28px; border-radius: 50%; display: inline-flex; align-items: center; justify-content: center; background: var(--club-bg); color: var(--club-fg); }

  .chero { padding-top: 24px; padding-bottom: 80px; align-items: center; }
  .chero__text { flex: 1 1 520px; min-width: 0; }
  .crumb { font-size: var(--text-sm); font-weight: 700; color: var(--color-navy); }
  .chero__ico { width: 76px; height: 76px; border-radius: 20px; background: var(--color-white); color: var(--club-fg); display: flex; align-items: center; justify-content: center; }
  .chero__h1 { margin: 0; font-size: clamp(40px, 5.4vw, 78px); line-height: var(--leading-tight); }
  .chero__tag { margin: 0; font-size: 24px; font-weight: 800; color: var(--color-navy); }
  .chero__tag span { background: var(--color-white); padding: 0 .15em; border-radius: .1em; -webkit-box-decoration-break: clone; box-decoration-break: clone; }
  .chero__desc :global(p) { margin: 0; }
  .chero__cover { flex: 1 1 420px; height: 420px; border-radius: var(--radius-big); overflow: hidden; border: 5px solid var(--color-white); box-shadow: 0 18px 44px rgba(11, 31, 74, .2); position: relative; box-sizing: border-box; }
  .chero__cover--icon { background: var(--club-bg); color: var(--club-fg); }
  .chero__soon { position: absolute; inset: 0; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 10px; font-weight: 800; font-size: var(--text-sm); text-align: center; padding: 16px; }

  .cbody { padding-top: 72px; padding-bottom: 88px; }
  .cmain { flex: 1 1 600px; min-width: 0; }
  .cmain :global(.h2) { font-size: clamp(26px, 2.6vw, 36px); margin-top: 0; }
  .cacts { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(min(220px, 100%), 1fr)); gap: 16px; }
  .cacts li { background: var(--club-bg); border-radius: 22px; padding: 22px; display: flex; flex-direction: column; gap: 8px; font-size: 16px; line-height: 1.5; }
  .cacts__n { font-size: 32px; line-height: 1; color: var(--club-fg); }
  .cacts b { color: var(--color-navy); font-size: 18px; line-height: 1.3; }
  .ctime { list-style: none; margin: 0; padding: 0; }
  .ctime li { display: grid; grid-template-columns: 84px 1fr; gap: 18px; padding: 16px 0; border-bottom: 1px solid var(--color-line); }
  .ctime__t { font-size: 20px; font-weight: var(--weight-display); color: var(--color-blue); }
  .ctime li > span > b { color: var(--color-navy); }
  .cgains { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 10px; }
  .cgains li { display: inline-flex; align-items: center; gap: 8px; min-height: 44px; padding: 0 18px; border-radius: var(--radius-pill); background: var(--color-navy); color: var(--color-white); font-weight: 800; font-size: 16px; }
  .cgains svg { color: var(--color-hl); }
  .cguide { display: flex; gap: 20px; align-items: center; background: var(--color-bg-sky); padding: 24px; border-radius: 22px; flex-wrap: wrap; }
  .cguide__av { width: 84px; height: 84px; border-radius: 50%; background: var(--color-hl); color: var(--color-navy); font-weight: var(--weight-display); font-size: 32px; display: flex; align-items: center; justify-content: center; flex: none; }

  .cside { flex: 0 1 360px; position: sticky; top: 24px; min-width: 0; }
  .cfacts { border: 3px solid var(--color-navy); border-radius: var(--radius-card); padding: 24px; display: flex; flex-direction: column; gap: 4px; }
  .cfacts__title { margin-bottom: 6px; }
  .cfacts dl { margin: 0; }
  .cfacts dl > div { display: flex; justify-content: space-between; gap: 12px; padding: 12px 0; border-bottom: 1px solid var(--color-line); font-size: 16px; }
  .cfacts dl > div:last-child { border-bottom: 0; }
  .cfacts dd { margin: 0; color: var(--color-navy); font-weight: 700; text-align: right; }
  .cfacts__price { background: var(--color-cyan); color: var(--color-navy); border-radius: 18px; padding: 16px 18px; margin: 12px 0 14px; display: flex; justify-content: space-between; align-items: baseline; gap: 10px; font-weight: 800; }
  .cfacts__price b { font-size: 28px; font-weight: var(--weight-display); }
  .cfacts__price small { font-size: var(--text-sm); font-weight: 800; }
  .cask { background: var(--color-navy); border-radius: 22px; padding: 20px 22px; color: var(--color-on-dark); font-size: var(--text-sm); display: flex; flex-direction: column; gap: 6px; }
  .cask a { color: var(--color-white); font-weight: var(--weight-display); font-size: 22px; text-decoration: none; min-height: var(--tap); display: inline-flex; align-items: center; gap: 10px; }
  .cask svg { color: var(--color-hl); }
  .cask a:focus-visible { outline-color: var(--color-hl); }

  .crel-sec :global(.h2) { font-size: clamp(26px, 2.6vw, 36px); margin-top: 0; }
  .crel { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(min(260px, 100%), 1fr)); gap: 18px; }
  .crel__card { height: 100%; box-sizing: border-box; display: flex; flex-direction: column; gap: 10px; background: var(--color-white); border: 1px solid var(--color-line); border-radius: 22px; padding: 20px; color: var(--color-ink); text-decoration: none; font-size: 16px; transition: transform .15s, box-shadow .15s; }
  .crel__card:hover { transform: translateY(-3px); box-shadow: var(--shadow-float); color: var(--color-ink); }
  .crel__ico { width: 52px; height: 52px; border-radius: 16px; display: flex; align-items: center; justify-content: center; background: var(--club-bg); color: var(--club-fg); }
  .crel__name { font-size: 22px; line-height: 1.2; }
  .crel__see { font-weight: var(--weight-display); color: var(--color-navy); margin-top: auto; }

  @media (max-width: 860px) {
    .chero { padding-top: 8px; padding-bottom: 40px; gap: 24px; }
    .chero__tag { font-size: 20px; }
    .chero__cover { height: 260px; flex-basis: 100%; }
    .cbody { padding-top: 48px; padding-bottom: 56px; }
    .cmain { --stack-gap: 48px !important; }
    .cside { position: static; flex-basis: 100%; }
    .ctime li { grid-template-columns: 64px 1fr; gap: 12px; }
  }
  @media (prefers-reduced-motion: reduce) { .crel__card { transition: none; } .crel__card:hover { transform: none; } }
</style>
