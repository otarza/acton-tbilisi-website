---
/**
 * FAQ PAGE (ხშირად დასმული კითხვები).
 * Questions: src/content/faq/ka/*.md   ·   Copy: pages/ka/faq.yaml   ·   Weekly-question archive: /questions
 */
import { render } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/shared/PageHero.astro';
import Assistant from '@/components/shared/Assistant.astro';
import CtaBand from '@/components/shared/CtaBand.astro';
import { getLocalized, getPage, slugOf } from '@/lib/content';
import { FAQ_CATEGORIES } from '@/content.config';
import { t } from '@/i18n/ui';

const p = await getPage('faqPage');
const ui = t();
const faqEntries = (await getLocalized('faq')).sort((a, b) => FAQ_CATEGORIES.indexOf(a.data.category) - FAQ_CATEGORIES.indexOf(b.data.category) || a.data.order - b.data.order);
const faqs = await Promise.all(faqEntries.map(async (f) => ({ ...f, slug: slugOf(f.id), Content: (await render(f)).Content })));
const cats = FAQ_CATEGORIES.filter((c) => faqs.some((f) => f.data.category === c));
const catTag = { status: 'tag--red', learning: 'tag--blue', progress: 'tag--gold', daily: 'tag--teal', enrollment: 'tag--green', clubs: 'tag--blue' } as const;
---
<BaseLayout title={p.seo.title} description={p.seo.description} ogPhoto="exhibition-talk">
  <PageHero slot="hero" label={p.hero.label} title={p.hero.title} accent={p.hero.accent} after={p.hero.after} lead={`${ui.faq.count(faqs.length, cats.length)} ${p.hero.lead}`} />

  <section id="faq" class="wrap sec faq" data-faq>
    <aside class="faq__side stack" style="--stack-gap: 8px">
      <b class="strong-navy">{ui.faq.topics}</b>
      <button type="button" class="cat" aria-pressed="true" data-cat="all"><span>{ui.faq.all}</span><span>{faqs.length}</span></button>
      {cats.map((c) => <button type="button" class="cat" aria-pressed="false" data-cat={c}><span>{p.categories[c] ?? c}</span><span>{faqs.filter((f) => f.data.category === c).length}</span></button>)}
      <div class="faq__asst"><Assistant /></div>
    </aside>
    <div class="acc faq__list">
      {faqs.map((f) => (
        <details id={f.slug} data-category={f.data.category} data-placeholder={f.data.placeholder || undefined}>
          <summary><span><span class={`tag ${catTag[f.data.category]}`}>{p.categories[f.data.category]}</span><br />{f.data.question}</span></summary>
          <div class="faq__a"><f.Content /></div>
        </details>
      ))}
    </div>
  </section>

  <CtaBand title={p.cta.title} accent={p.cta.accent} button={p.cta.button} />
</BaseLayout>
<script>
  for (const root of document.querySelectorAll<HTMLElement>('[data-faq]')) {
    const btns = root.querySelectorAll<HTMLElement>('[data-cat]');
    btns.forEach((b) => b.addEventListener('click', () => {
      btns.forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
      root.querySelectorAll<HTMLElement>('[data-category]').forEach((d) => (d.hidden = b.dataset.cat !== 'all' && d.dataset.category !== b.dataset.cat));
    }));
    // Open the question linked from the assistant (/faq#slug)
    const open = () => { const el = location.hash && document.getElementById(location.hash.slice(1)); if (el instanceof HTMLDetailsElement) el.open = true; };
    open(); window.addEventListener('hashchange', open);
  }
</script>
<style>
  .faq { display: flex; flex-wrap: wrap; gap: 48px; align-items: flex-start; }
  .faq__side { flex: 0 1 340px; position: sticky; top: 16px; }
  .faq__list { flex: 1 1 560px; min-width: 0; }
  .faq__list details[hidden] { display: none; }
  .faq__a { padding-top: 4px; max-width: 720px; }
  .faq__asst { margin-top: 16px; }
  .cat { display: flex; justify-content: space-between; align-items: center; min-height: var(--tap); padding: 0 18px; border-radius: var(--radius-sm); border: 2px solid var(--color-navy); background: var(--color-white); color: var(--color-navy); font-weight: 800; font-size: 16px; cursor: pointer; }
  .cat[aria-pressed="true"] { background: var(--color-navy); color: var(--color-white); }
  @media (max-width: 860px) { .faq__side { position: static; flex-basis: 100%; } .faq__asst { display: none; } }
</style>
