---
/** ABOUT PAGE. Copy: src/content/pages/ka/about.yaml. Team: src/content/team/ka/. */
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/shared/PageHero.astro';
import SectionHeading from '@/components/ui/SectionHeading.astro';
import TeamExplorer from '@/components/about/TeamExplorer.astro';
import ConsentDemo from '@/components/about/ConsentDemo.astro';
import CtaBand from '@/components/shared/CtaBand.astro';
import { getPage } from '@/lib/content';
const p = await getPage('aboutPage');
const statusTag = { confirmed: 'tag--green', pending: 'tag--gold', info: 'tag--blue' } as const;
---
<BaseLayout title={p.seo.title} description={p.seo.description} ogPhoto="ant-quest">
  <PageHero slot="hero" label={p.hero.label} title={p.hero.title} accent={p.hero.accent} after={p.hero.after} lead={p.hero.lead} placeholder={p.hero.placeholder}>
    <div class="stats">
      {p.hero.stats.map((s) => <div class="card"><div class="display stats__big">{s.big}</div><span class="small">{s.text}</span></div>)}
    </div>
  </PageHero>

  <section class="wrap sec row" style="--row-gap: 48px">
    <div style="flex: 1 1 420px"><SectionHeading num="01" label={p.story.label} title={p.story.title} accent={p.story.accent} /></div>
    <ol class="story" data-placeholder={p.story.placeholder || undefined}>
      {p.story.items.map((s) => <li><span class="story__dot" aria-hidden="true"></span><div class="story__body"><b class="accent">{s.when}</b><h3 class="display h3">{s.title}</h3><p>{s.text}</p></div></li>)}
    </ol>
  </section>

  <TeamExplorer />

  <section id="accreditation" class="wrap sec stack" style="--stack-gap: 32px">
    <SectionHeading num="03" label={p.accreditation.label} title={p.accreditation.title} accent={p.accreditation.accent} />
    <div class="grid-auto" style="--min: 300px">
      {p.accreditation.cards.map((c) => (
        <div class:list={['card card--float stack', { 'card--pending': c.status === 'pending' }]} style="--stack-gap: 12px" data-placeholder={c.status === 'pending' || undefined}>
          <span class={`tag ${statusTag[c.status]}`}>{c.statusLabel}</span>
          <h3 class="display h3">{c.title}</h3>
          <p class="small">{c.text}</p>
          {c.link && <a href={c.link.href} class="strong-navy small">{c.link.text}</a>}
        </div>
      ))}
    </div>
  </section>

  <section id="safety" class="bg-navy sec">
    <div class="wrap stack" style="--stack-gap: 32px">
      <div class="stack" style="--stack-gap: 12px">
        <SectionHeading num="04" label={p.safety.label} title={p.safety.title} accent={p.safety.accent} onDark />
        <p style="max-width: 640px">{p.safety.intro}</p>
      </div>
      <ul class="safety" data-placeholder={p.safety.placeholder || undefined}>
        {p.safety.items.map((s) => <li><span class="safety__i" aria-hidden="true">{s.icon}</span><b>{s.title}</b><span class="small">{s.text}</span></li>)}
      </ul>
    </div>
  </section>

  <section id="privacy" class="wrap sec row" style="--row-gap: 48px; align-items: flex-start">
    <div class="stack" style="flex: 1 1 520px; --stack-gap: 20px">
      <SectionHeading num="05" label={p.privacy.label} title={p.privacy.title} accent={p.privacy.accent} />
      <p>{p.privacy.intro}</p>
      <div class="acc">
        {p.privacy.details.map((d) => <details><summary>{d.q}</summary><p>{d.a}</p></details>)}
      </div>
    </div>
    <div style="flex: 1 1 380px; min-width: 0"><ConsentDemo /></div>
  </section>

  <CtaBand title={p.cta.title} accent={p.cta.accent} button={p.cta.button} />
</BaseLayout>
<style>
  .stats { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
  .stats .card { padding: 22px; }
  .stats .small { color: var(--color-navy); }
  .stats__big { font-size: 44px; line-height: 1.1; }
  /* Story: vertical trail with dots, like the "Hero's path" */
  .story { flex: 1 1 560px; list-style: none; margin: 0; padding: 0; }
  .story li { display: grid; grid-template-columns: 18px 1fr; gap: 20px; position: relative; }
  .story li:not(:last-child)::before { content: ""; position: absolute; left: 7px; top: 18px; bottom: 0; border-left: 3px dashed var(--color-trail); }
  .story__dot { width: 18px; height: 18px; border-radius: 50%; background: var(--color-blue); border: 4px solid var(--color-hl); margin-top: 6px; }
  .story__body { padding-bottom: 28px; display: flex; flex-direction: column; gap: 4px; }
  .card--pending { border: 2px dashed var(--color-red-bright); box-shadow: none; }
  .safety { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(min(300px, 100%), 1fr)); gap: 16px; }
  .safety li { background: rgba(255, 255, 255, .06); border: 1px solid rgba(122, 253, 255, .25); border-radius: 22px; padding: 22px; display: flex; flex-direction: column; gap: 6px; }
  .safety b { color: var(--color-white); }
  .safety__i { font-size: 26px; }
</style>
